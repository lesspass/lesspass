{
  "name": "lesspass-web-site",
  "description": "LessPass web site",
  "version": "0.1.0",
  "license": "GPL-3.0",
  "author": "Guillaume Vincent <guillaume@oslab.fr>",
  "type": "module",
  "scripts": {
    "dev": "yarn i18n && vite",
    "build": "yarn i18n && vite build",
    "i18n": "rm -rf mkdir ./public/locales && mkdir -p ./public/locales && cp -r ../lesspass-i18n/src/locales/* ./public/locales/ && echo 'translations copied'",
    "lint": "eslint .",
    "prettier": "prettier --write src",
    "preview": "vite preview"
  },
  "dependencies": {
    "lesspass-web-component": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
