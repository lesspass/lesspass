{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "paths": {} // Resolve workspace deps (lesspass) as external built packages, not source, so tsc emit stays within rootDir
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/mocks", "src/setup.ts"]
}
