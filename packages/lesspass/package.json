{
  "name": "lesspass",
  "version": "10.0.0",
  "description": "LessPass core module",
  "license": "GPL-3.0",
  "author": "Guillaume Vincent <guillaume@oslab.fr>",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./render-password": {
