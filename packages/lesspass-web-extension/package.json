{
  "name": "lesspass-web-extension",
  "version": "11.0.1",
  "description": "LessPass Web Extension",
  "license": "GPL-3.0-only",
  "author": "Guillaume Vincent <guillaume@oslab.fr>",
  "type": "module",
  "scripts": {
    "build": "yarn clean && yarn i18n && vite build",
    "clean": "rm -rf dist",
    "i18n": "rm -rf mkdir ./dist/locales && mkdir -p ./dist/locales && cp -r ../lesspass-i18n/src/locales/* ./dist/locales/ && echo 'translations copied'",
    "release": "yarn clean && yarn build && yarn amo && yarn cws",
    "release:amo": "yarn clean && yarn build && yarn amo",
    "release:cws": "yarn clean && yarn build && yarn cws",
    "amo": "cd dist && web-ext sign --channel=listed",
    "cws": "cd dist && chrome-webstore-upload",
    "dev": "vite",
    "lint": "eslint .",
    "prettier": "prettier --write src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "lesspass-i18n": "workspace:*",
    "lesspass-web-component": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chrome-webstore-upload-cli": "^4.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0"
  }
}
